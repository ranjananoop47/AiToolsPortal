<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - AI Tools Intelligence Portal</title>
    
    <!-- Google Fonts & Bootstrap Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    
    <!-- Custom Stylesheet -->
    <link href="@Url.Content("~/Content/css/styles.css")" rel="stylesheet" />
</head>
<body class="bg-body text-body">
    <!-- Navigation Bar -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom border-secondary-subtle py-2 shadow-sm">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand d-flex align-items-center gap-2" href="@Url.Action("Index", "Home")">
                    <span class="brand-icon">
                        <i class="bi bi-cpu-fill text-primary"></i>
                    </span>
                    <span class="fw-bold tracking-tight text-gradient">AI Nexus Portal</span>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill fs-xs">.NET MVC</span>
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link active" href="@Url.Action("Index", "Home")">
                                <i class="bi bi-grid-fill me-1 text-primary"></i> Hub & Tools
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home", new { tab = "matrix" })">
                                <i class="bi bi-table me-1 text-info"></i> Comparison Matrix
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("About", "Home")">
                                <i class="bi bi-info-circle me-1 text-warning"></i> Architecture & Info
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <!-- Theme Toggle -->
                        <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" id="themeToggleBtn" type="button" title="Toggle Light / Dark mode">
                            <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
                            <span class="d-none d-md-inline ms-1" id="themeLabel">Dark</span>
                        </button>
                        
                        <a href="https://github.com" target="_blank" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm d-flex align-items-center gap-1">
                            <i class="bi bi-robot"></i> 9 AI Tools
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Body -->
    <main class="py-4">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="border-top border-secondary-subtle py-4 mt-5 bg-body-tertiary">
        <div class="container text-center">
            <div class="row align-items-center">
                <div class="col-md-6 text-md-start mb-3 mb-md-0">
                    <p class="mb-0 text-secondary small">
                        &copy; @DateTime.Now.Year <strong>AI Nexus Intelligence Portal</strong>. Built with C# ASP.NET MVC (.NET Framework 4.8).
                    </p>
                    <p class="mb-0 text-secondary-emphasis fs-xs">
                        Featuring NotebookLM, Stitch, AI Studio, Wispr Flow, Claude, Julius, Higgsfield, Claude Skills, and ElevenLabs.
                    </p>
                </div>
                <div class="col-md-6 text-md-end">
                    <div class="d-inline-flex gap-2">
                        <span class="badge bg-secondary-subtle text-secondary-emphasis">ASP.NET MVC 5</span>
                        <span class="badge bg-secondary-subtle text-secondary-emphasis">Razor View Engine</span>
                        <span class="badge bg-secondary-subtle text-secondary-emphasis">Bootstrap 5.3</span>
                        <span class="badge bg-secondary-subtle text-secondary-emphasis">YouTube Embedded API</span>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="@Url.Content("~/Scripts/app.js")"></script>
</body>
</html>
